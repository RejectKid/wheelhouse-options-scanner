# Wheelhouse reads Alpaca credentials from its own local .env file.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Free Alpaca accounts should use indicative. Set opra after upgrading.
ALPACA_OPTIONS_FEED=indicative
ALPACA_STOCK_FEED=iex

# Scan controls chosen to stay below Alpaca Basic's 200 request/minute limit.
WHEELHOUSE_UNDERLYING_LIMIT=80
WHEELHOUSE_SCAN_CACHE_SECONDS=300
